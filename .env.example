# Optional — app works offline with seeded demo data
# Keep this file at repo root (symlink also at apps/web/.env for Next).
# OPENAI_API_KEY: optional memo language polish only (scores/decision stay deterministic)
OPENAI_API_KEY=
# Cheapest solid chat model (default in code: gpt-4.1-nano). Override if needed:
# OPENAI_MODEL=gpt-4.1-nano
FIRECRAWL_API_KEY=
# Opt-in only — Firecrawl JSON/LLM extract (~5 credits/page). Default off.
# FIRECRAWL_ALLOW_JSON_EXTRACT=1
# Tavily: deep web search for Gravity Audit + VC Brain deep research (Bearer tvly-…)
TAVILY_API_KEY=
# Deep diligence budgets (optional)
# DEEP_RESEARCH_TIMEOUT_MS=55000
# DEEP_RESEARCH_MAX_SCRAPES=3
COMPOSIO_API_KEY=
# GitHub: classic PAT or fine-grained with Metadata + Contents Read (public repos)
# Used for /users, /repos, and search/repositories (higher rate limits)
GITHUB_TOKEN=
E2B_API_KEY=
# Brand memory (v4 memories/search/profile). Founder Score stays local.
SUPERMEMORY_API_KEY=

# Public site
# Production (canonical): https://www.vibemarketer.fun
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Show Google button only after Supabase Google provider is enabled:
# NEXT_PUBLIC_GOOGLE_OAUTH=1
NEXT_PUBLIC_CAL_URL=https://calendly.com/0xanand
NEXT_PUBLIC_CONTACT_EMAIL=hello@vibemarketer.fun
NEXT_PUBLIC_X_URL=https://x.com/AnandVashisht15
NEXT_PUBLIC_GITHUB_URL=https://github.com/Anand-0037
NEXT_PUBLIC_LINKEDIN_URL=https://www.linkedin.com/in/anand-vashishtha-aba64b255/

# Billing (Dodo Payments) — optional; Solo/Startup CTAs fall back to waitlist
# https://docs.dodopayments.com/api-reference/checkout-sessions/create
DODO_PAYMENTS_API_KEY=
# test | live  (default test → test.dodopayments.com)
DODO_PAYMENTS_ENV=test
DODO_PRODUCT_ID_SOLO=
DODO_PRODUCT_ID_STARTUP=

# Auth (Supabase) — see AUTH.md
# Local CLI defaults after `supabase start`:
# NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<anon/publishable from `supabase status`>
# Or use a free Supabase cloud project URL + publishable/anon key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy alias (also accepted):
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only — dual-write Memory → Postgres ledgers (never expose to browser)
# SUPABASE_SERVICE_ROLE_KEY=
# USE_POSTGRES_DUAL=1
# Never set VC_BRAIN_WORKSPACE_ID in multi-user prod (forces shared workspace).
# Only with ALLOW_SHARED_WORKSPACE=1 for intentional single-tenant demos.
# VC_BRAIN_WORKSPACE_ID=
# ALLOW_SHARED_WORKSPACE=1

# Force open /app without login (local only). Default: bypass when URL/key unset.
# AUTH_BYPASS=1
# AUTH_BYPASS=0
# Hosted production refuses missing Supabase / AUTH_BYPASS=1 unless:
# ALLOW_OPEN_APP=1

# Prefill operator dogfood data in onboarding/apply/waitlist forms.
# Default: on in local/dev, off in production. Force with 1 / 0:
# NEXT_PUBLIC_DEMO_DEFAULTS=0

# Optional error webhook (Slack/Discord/Sentry-compatible JSON POST)
# ERROR_WEBHOOK_URL=

